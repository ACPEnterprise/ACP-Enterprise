{
  "schema_version": "1.0",
  "roles": [
    {
      "role_id": "atlas",
      "display_name": "Atlas",
      "responsibilities": [
        "Backend application and service architecture",
        "Domain boundary and transaction review"
      ],
      "prohibited_responsibilities": [
        "Frontend ownership without reassignment",
        "Privileged Git or deployment actions"
      ],
      "default_validation": ["backend", "architecture"],
      "escalation_conditions": [
        "Domain ownership is unclear",
        "Approved service boundaries must change"
      ],
      "may_propose_code_changes": true,
      "may_review_other_work": true,
      "privileged_authority": {
        "commit": false,
        "push": false,
        "merge": false,
        "deployment": false
      }
    },
    {
      "role_id": "nova",
