{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp.enterprise/schemas/development-factory/worker-operations-1.0.json",
  "title": "LIA Worker Operations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "task_id",
    "workspace_id",
    "allowed_action_classes",
    "operations",
    "validation_selections",
    "termination_policy",
    "required_report_fields"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "execution_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "allowed_action_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["inspection", "mutation", "validation"]}
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "operation",
          "path",
          "paths",
          "text",
          "expected_text",
          "replacement_text",
          "resource_type",
          "resource_id"
        ],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "operation": {
            "enum": [
              "inspect_file",
              "inspect_paths",
              "write_text_file",
              "append_text_file",
              "replace_exact_text",
              "create_demonstration_file"
            ]
          },
          "path": {"type": ["string", "null"]},
          "paths": {"type": "array", "items": {"type": "string"}},
          "text": {"type": ["string", "null"]},
          "expected_text": {"type": ["string", "null"]},
          "replacement_text": {"type": ["string", "null"]},
          "resource_type": {"type": ["string", "null"]},
          "resource_id": {"type": ["string", "null"]}
        }
      }
    },
    "validation_selections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["all", "changed", "backend", "frontend", "migrations", "architecture"]
      }
    },
    "termination_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_operations",
        "maximum_mutations",
        "maximum_files_inspected",
        "maximum_files_changed",
        "maximum_output_record_bytes",
        "maximum_validation_selections",
        "execution_timeout_seconds"
      ],
      "properties": {
        "maximum_operations": {"type": "integer", "minimum": 1},
        "maximum_mutations": {"type": "integer", "minimum": 1},
        "maximum_files_inspected": {"type": "integer", "minimum": 1},
        "maximum_files_changed": {"type": "integer", "minimum": 1},
        "maximum_output_record_bytes": {"type": "integer", "minimum": 1},
        "maximum_validation_selections": {"type": "integer", "minimum": 1},
        "execution_timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "required_report_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
