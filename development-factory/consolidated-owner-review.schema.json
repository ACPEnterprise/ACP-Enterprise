{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp.enterprise/schemas/development-factory/consolidated-owner-review-1.0.json",
  "title": "LIA Consolidated Owner Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "supervisory_run_id",
    "parent_milestone",
    "parent_objective",
    "approved_branch",
    "approved_starting_sha",
    "supervisory_contract_digest",
    "evidence_chain_digest",
    "included_worker_records",
    "excluded_or_missing_workers",
    "execution_waves",
    "dependency_status",
    "worker_reviews",
    "workspace_provenance_findings",
    "verified_changed_file_summaries",
    "file_conflicts",
    "resource_conflicts",
    "migration_schema_findings",
    "architecture_security_findings",
    "validation_summaries",
    "aggregate_revalidation_requirements",
    "recommended_review_order",
    "advisory_future_integration_order",
    "rejected_or_noneligible_outputs",
    "blockers",
    "escalations",
    "owner_decisions_required",
    "recorded_owner_decisions",
    "secret_redaction_result",
    "action_audit",
    "state_history",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "review_id": {"type": "string"},
    "supervisory_run_id": {"type": "string"},
    "parent_milestone": {"type": "string"},
    "parent_objective": {"type": "string"},
    "approved_branch": {"type": "string"},
    "approved_starting_sha": {"type": "string"},
    "supervisory_contract_digest": {"type": "string"},
    "evidence_chain_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "included_worker_records": {"type": "array"},
    "excluded_or_missing_workers": {"type": "array"},
    "execution_waves": {"type": "array"},
    "dependency_status": {"type": "array"},
    "worker_reviews": {"type": "array"},
    "workspace_provenance_findings": {"type": "array"},
    "verified_changed_file_summaries": {"type": "array"},
    "file_conflicts": {"type": "array"},
    "resource_conflicts": {"type": "array"},
    "migration_schema_findings": {"type": "array"},
    "architecture_security_findings": {"type": "array"},
    "validation_summaries": {"type": "array"},
    "aggregate_revalidation_requirements": {"type": "array"},
    "recommended_review_order": {"type": "array"},
    "advisory_future_integration_order": {"type": "array"},
    "rejected_or_noneligible_outputs": {"type": "array"},
    "blockers": {"type": "array"},
    "escalations": {"type": "array"},
    "owner_decisions_required": {"type": "array"},
    "recorded_owner_decisions": {"type": "array"},
    "secret_redaction_result": {"const": "applied"},
    "action_audit": {"type": "object"},
    "state_history": {"type": "array"},
    "created_at": {"type": "string"}
  }
}
