{
  "schema_version": "1.0",
  "checks": [
    {
      "id": "repo.state",
      "name": "Repository state inspection",
      "category": "repository",
      "implementation": "repository_state",
      "required": true,
      "areas": ["all"],
      "timeout_seconds": 30,
      "dependencies": ["git"],
      "failure_classification": "repository",
      "parallel": false,
      "order": 10
    },
    {
      "id": "repo.diff",
      "name": "Git diff whitespace checks",
      "category": "repository",
      "command": ["git", "diff", "--check"],
      "required": true,
      "areas": ["all"],
      "timeout_seconds": 30,
      "dependencies": ["git"],
      "failure_classification": "repository",
      "parallel": true,
      "order": 20
    },
    {
      "id": "repo.cached_diff",
      "name": "Staged diff whitespace checks",
      "category": "repository",
      "command": ["git", "diff", "--cached", "--check"],
      "required": true,
      "areas": ["all"],
      "timeout_seconds": 30,
      "dependencies": ["git"],
      "failure_classification": "repository",
      "parallel": true,
      "order": 30
    },
    {
      "id": "architecture.boundaries",
      "name": "Architecture and security policies",
      "category": "architecture",
      "implementation": "policy_scan",
      "required": true,
      "areas": ["architecture"],
      "timeout_seconds": 120,
      "dependencies": [],
      "failure_classification": "architecture",
      "parallel": false,
      "order": 40
    },
    {
      "id": "backend.format",
      "name": "Backend Ruff format",
      "category": "backend",
      "command": ["docker", "exec", "acp-enterprise-backend", "sh", "-lc", "ruff format --check app tests development_factory"],
      "required": true,
      "areas": ["backend"],
      "timeout_seconds": 180,
      "dependencies": ["docker"],
      "failure_classification": "quality",
      "parallel": false,
      "order": 100
    },
    {
      "id": "backend.lint",
      "name": "Backend Ruff lint",
      "category": "backend",
      "command": ["docker", "exec", "acp-enterprise-backend", "sh", "-lc", "ruff check app tests development_factory"],
      "required": true,
      "areas": ["backend"],
      "timeout_seconds": 180,
      "dependencies": ["docker"],
      "failure_classification": "quality",
      "parallel": false,
      "order": 110
    },
    {
      "id": "backend.types",
      "name": "Backend MyPy",
      "category": "backend",
      "command": ["docker", "exec", "acp-enterprise-backend", "sh", "-lc", "mypy app tests development_factory"],
      "required": true,
      "areas": ["backend"],
      "timeout_seconds": 300,
      "dependencies": ["docker"],
      "failure_classification": "quality",
      "parallel": false,
      "order": 120
    },
    {
      "id": "backend.tests",
      "name": "Backend tests",
      "category": "backend",
      "implementation": "backend_tests",
      "required": true,
      "areas": ["backend"],
      "timeout_seconds": 1200,
      "dependencies": ["docker"],
      "failure_classification": "test",
      "parallel": false,
      "order": 130
    },
    {
      "id": "frontend.lint",
      "name": "Frontend ESLint",
      "category": "frontend",
      "command": ["npm", "run", "lint"],
      "working_directory": "frontend",
      "required": true,
      "areas": ["frontend"],
      "timeout_seconds": 300,
      "dependencies": ["npm"],
      "failure_classification": "quality",
      "parallel": false,
      "order": 200
    },
    {
      "id": "frontend.tests",
      "name": "Frontend Vitest",
      "category": "frontend",
      "command": ["npm", "run", "test:run"],
      "working_directory": "frontend",
      "required": true,
      "areas": ["frontend"],
      "timeout_seconds": 900,
      "dependencies": ["npm"],
      "failure_classification": "test",
      "parallel": false,
      "order": 210
    },
    {
      "id": "frontend.build",
      "name": "Frontend TypeScript and production build",
      "category": "frontend",
      "command": ["npm", "run", "build"],
      "working_directory": "frontend",
      "required": true,
      "areas": ["frontend"],
      "timeout_seconds": 600,
      "dependencies": ["npm"],
      "failure_classification": "build",
      "parallel": false,
      "order": 220
    },
    {
      "id": "migrations.safety",
      "name": "Disposable PostgreSQL migration lifecycle",
      "category": "migrations",
      "implementation": "migration_validation",
      "required": true,
      "areas": ["migrations"],
      "timeout_seconds": 600,
      "dependencies": ["docker"],
      "failure_classification": "migration",
      "parallel": false,
      "order": 300
    }
  ]
}
