{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp.enterprise/schemas/development-factory/worker-execution-record-1.1.json",
  "title": "LIA Worker Execution Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "supervisory_run_id",
    "parent_milestone",
    "worker_task_id",
    "worker_id",
    "role_id",
    "role_display_name",
    "workspace_id",
    "workspace_path",
    "approved_owner_branch",
    "approved_starting_sha",
    "expected_workspace_branch",
    "actual_starting_branch",
    "actual_ending_branch",
    "starting_head",
    "ending_head",
    "initial_workspace_status",
    "final_workspace_status",
    "initial_index_clean",
    "final_index_clean",
    "state_history",
    "effective_permissions",
    "requested_operations",
    "performed_operations",
    "denied_operations",
    "files_inspected",
    "files_changed",
    "untracked_files",
    "staged_files",
    "boundary_violations",
    "resource_violations",
    "contamination_findings",
    "validation_results",
    "blockers",
    "escalations",
    "secret_redaction_result",
    "recommended_worker_state",
    "owner_review_required",
    "action_audit",
    "started_at",
    "completed_at",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "execution_id": {"type": "string"},
    "supervisory_run_id": {"type": "string"},
    "parent_milestone": {"type": "string"},
    "worker_task_id": {"type": "string"},
    "worker_id": {"type": "string"},
    "role_id": {"type": "string"},
    "role_display_name": {"type": "string"},
    "workspace_id": {"type": "string"},
    "workspace_path": {"type": "string"},
    "approved_owner_branch": {"type": "string"},
    "approved_starting_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "expected_workspace_branch": {"type": "string"},
    "actual_starting_branch": {"type": "string"},
    "actual_ending_branch": {"type": "string"},
    "starting_head": {"type": "string"},
    "ending_head": {"type": "string"},
    "initial_workspace_status": {"type": "string"},
    "final_workspace_status": {"type": "string"},
    "initial_index_clean": {"type": "boolean"},
    "final_index_clean": {"type": "boolean"},
    "state_history": {"type": "array", "items": {"type": "string"}},
    "effective_permissions": {"type": "array", "items": {"type": "string"}},
    "requested_operations": {"type": "array", "items": {"type": "object"}},
    "performed_operations": {"type": "array", "items": {"type": "object"}},
    "denied_operations": {"type": "array", "items": {"type": "object"}},
    "files_inspected": {"type": "array", "items": {"type": "string"}},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "untracked_files": {"type": "array", "items": {"type": "string"}},
    "staged_files": {"type": "array", "items": {"type": "string"}},
    "boundary_violations": {"type": "array", "items": {"type": "string"}},
    "resource_violations": {"type": "array", "items": {"type": "string"}},
    "contamination_findings": {"type": "array", "items": {"type": "string"}},
    "validation_results": {"type": "array", "items": {"type": "object"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "escalations": {"type": "array", "items": {"type": "string"}},
    "secret_redaction_result": {"const": "applied"},
    "recommended_worker_state": {"enum": ["completed", "blocked", "failed"]},
    "owner_review_required": {"const": true},
    "action_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staged_by_factory",
        "committed_by_factory",
        "pushed_by_factory",
        "merged_by_factory",
        "deployed_by_factory",
        "workspace_deleted_by_factory"
      ],
      "properties": {
        "staged_by_factory": {"const": false},
        "committed_by_factory": {"const": false},
        "pushed_by_factory": {"const": false},
        "merged_by_factory": {"const": false},
        "deployed_by_factory": {"const": false},
        "workspace_deleted_by_factory": {"const": false}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "assignment_id",
        "supervisory_contract_digest",
        "workspace_metadata_reference",
        "workspace_metadata_digest",
        "operations_manifest_digest",
        "validation_plan_id",
        "validation_selections",
        "validation_plan_digest",
        "validation_evidence_reference",
        "validation_evidence_digest",
        "output_manifest_digest",
        "output_files",
        "declared_allowed_paths",
        "declared_operation_ids",
        "artifact_references",
        "approval_state",
        "integration_state",
        "cleanup_state",
        "manifest_digest"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "assignment_id": {"type": "string"},
        "supervisory_contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "workspace_metadata_reference": {"type": "string"},
        "workspace_metadata_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "operations_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "validation_plan_id": {"type": "string"},
        "validation_selections": {"type": "array", "items": {"type": "string"}},
        "validation_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "validation_evidence_reference": {"type": "string"},
        "validation_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "output_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "output_files": {"type": "array", "items": {"type": "object"}},
        "declared_allowed_paths": {"type": "array", "items": {"type": "string"}},
        "declared_operation_ids": {"type": "array", "items": {"type": "string"}},
        "artifact_references": {"type": "array", "items": {"type": "string"}},
        "approval_state": {"const": "owner_review_required"},
        "integration_state": {"const": "not_integrated"},
        "cleanup_state": {"const": "workspace_retained"},
        "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
