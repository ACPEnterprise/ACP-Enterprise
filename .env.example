APP_NAME=ACP Enterprise
APP_VERSION=0.1.0
ENVIRONMENT=development

POSTGRES_DB=acp_enterprise
POSTGRES_USER=acp_enterprise
POSTGRES_PASSWORD=replace_this_password

DATABASE_URL=postgresql+asyncpg://acp_enterprise:replace_this_password@postgres:5432/acp_enterprise
REDIS_URL=redis://redis:6379/0

# Real delivery remains disabled until provider selection and environment-specific
# secret references/sender evidence are owner-approved. Never place secrets here.
COMMUNICATIONS_DELIVERY_ENABLED=false
