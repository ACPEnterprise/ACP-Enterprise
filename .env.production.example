# Production values belong in a mode-0600 file on the isolated Production host.
# Never copy Preview secrets, database URLs, Redis credentials, or provider tokens.

COMPOSE_PROJECT_NAME=twelve-hats-production
PRODUCTION_HTTP_PORT=8081

APP_NAME=Twelve Hats
APP_VERSION=SET_TO_EXACT_PROTECTED_SHA
ENVIRONMENT=production
BUSINESS_TIMEZONE=America/New_York
LOG_LEVEL=INFO
PLATFORM_CONTRACT_EXPECTED_FINGERPRINT=SET_TO_APPROVED_PLATFORM_CONTRACT_FINGERPRINT

# Images must be immutable registry references containing @sha256:.
ACP_BACKEND_IMAGE=SET_TO_REGISTRY_BACKEND_IMAGE@sha256:SET_TO_DIGEST
ACP_FRONTEND_IMAGE=SET_TO_REGISTRY_FRONTEND_IMAGE@sha256:SET_TO_DIGEST

# Production PostgreSQL and Redis must be private and independent from Preview.
DATABASE_URL=postgresql+asyncpg://SET_PRODUCTION_USER:SET_URL_ENCODED_PASSWORD@SET_PRIVATE_POSTGRES_HOST:5432/SET_PRODUCTION_DATABASE
REDIS_URL=rediss://SET_REDIS_USER@SET_PRIVATE_REDIS_HOST:6379/0
REDIS_USERNAME=SET_REDIS_USER
PRODUCTION_REDIS_SECRET_DIR_HOST=/opt/twelve-hats-production/shared/secrets/redis

# Owner-selected Production hostname. Do not use the Preview hostname.
PRODUCTION_HOSTNAME=app.twelve-hats.com
CORS_ALLOWED_ORIGINS=["https://app.twelve-hats.com"]
ALLOWED_HOSTS=["app.twelve-hats.com","backend","localhost","127.0.0.1"]
TRUST_FORWARDED_HEADERS=true
TRUSTED_PROXY_CIDRS=["172.31.0.0/24"]

# Generate independent Production-only values in the approved secret manager.
ACCESS_TOKEN_ACTIVE_KID=production-SET_ROTATION_ID
ACCESS_TOKEN_KEYS={"production-SET_ROTATION_ID":"SET_TO_AT_LEAST_32_RANDOM_CHARACTERS"}
ACCESS_TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_ISSUER=twelve-hats-production
ACCESS_TOKEN_AUDIENCE=twelve-hats-production-api
SECURITY_TOKEN_HMAC_KEY=SET_TO_DIFFERENT_AT_LEAST_32_RANDOM_CHARACTERS

PRODUCTION_PROTECTED_SECRET_DIR_HOST=/opt/twelve-hats-production/shared/secrets/platform
IDENTITY_ONBOARDING_DELIVERY_KEY_FILE=/run/secrets/twelve-hats/identity-onboarding-delivery-keyring.json
IDENTITY_ONBOARDING_ACTIVE_DELIVERY_KID=SET_PRODUCTION_DELIVERY_KID
IDENTITY_ONBOARDING_DELIVERY_PROVIDER=owner-mediated-production
IDENTITY_EMAIL_ACTIVATION_ORIGIN=https://SET_OWNER_APPROVED_PRODUCTION_HOSTNAME
PAYROLL_INPUT_ENCRYPTION_KEY_FILE=/run/secrets/twelve-hats/payroll-input-encryption-keyring.json
PAYROLL_INPUT_ACTIVE_KID=SET_PRODUCTION_PAYROLL_INPUT_KID

# Initial controlled launch keeps external communications disabled.
COMMUNICATIONS_DELIVERY_ENABLED=false
COMMUNICATIONS_WEBHOOK_ENABLED=false

# Production never runs QBO sandbox or the QBO Production acquisition control.
QBO_SANDBOX_ENABLED=false
QBO_PRODUCTION_ENABLED=false
QBO_PRODUCTION_EVIDENCE_ROOT=/var/lib/twelve-hats-evidence/qbo-production-readonly
HCP_SOURCE4_EVIDENCE_ROOT=/var/lib/twelve-hats-evidence/hcp/source4
PRODUCTION_EVIDENCE_DIR_HOST=/opt/twelve-hats-production/shared/evidence

SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Explicit resource envelopes. Tune from observed load; do not remove limits.
BACKEND_WORKERS=2
BACKEND_CPUS=2.0
BACKEND_MEMORY_LIMIT=2g
BACKEND_PIDS_LIMIT=256
FRONTEND_CPUS=1.0
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_PIDS_LIMIT=128
