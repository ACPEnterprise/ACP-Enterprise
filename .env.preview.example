# Copy this file to .env.preview on the preview server. Never commit .env.preview.
# Values containing JSON must remain valid JSON on one line.

COMPOSE_PROJECT_NAME=acp-enterprise-preview
PREVIEW_HTTP_PORT=8080

APP_NAME=ACP Enterprise
APP_VERSION=0.1.0
BUSINESS_TIMEZONE=America/New_York
LOG_LEVEL=INFO
PLATFORM_CONTRACT_EXPECTED_FINGERPRINT=SET_TO_APPROVED_PLATFORM_CONTRACT_FINGERPRINT

# Use a preview-only database name and credentials. The password in DATABASE_URL
# must be URL-encoded if it contains reserved URL characters.
POSTGRES_DB=acp_enterprise_preview
POSTGRES_USER=acp_enterprise
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PREVIEW_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://acp_enterprise:REPLACE_WITH_URL_ENCODED_PREVIEW_DATABASE_PASSWORD@postgres:5432/acp_enterprise_preview
REDIS_URL=redis://redis:6379/0
REDIS_USERNAME=acp-application
REDIS_SECRET_DIR_HOST=/opt/acp-enterprise/shared/secrets/redis-preview

# Exact browser origins and host names only. Wildcards are rejected in preview.
CORS_ALLOWED_ORIGINS=["https://preview.allcountyhomeservices.com"]
ALLOWED_HOSTS=["preview.allcountyhomeservices.com","backend","localhost","127.0.0.1"]

# The fixed Compose preview network is the only trusted application proxy network.
TRUST_FORWARDED_HEADERS=true
TRUSTED_PROXY_CIDRS=["172.30.0.0/24"]

# Generate independent preview-only values. Each secret must contain at least
# 32 random characters. ACCESS_TOKEN_KEYS is a JSON object keyed by signing-key ID.
ACCESS_TOKEN_ACTIVE_KID=preview-2026-01
ACCESS_TOKEN_KEYS={"preview-2026-01":"REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"}
ACCESS_TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_ISSUER=acp-enterprise-preview
ACCESS_TOKEN_AUDIENCE=acp-enterprise-preview-api
SECURITY_TOKEN_HMAC_KEY=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_RANDOM_SECRET

# Communications provider admission. Keep delivery disabled until the complete
# Preview acceptance sequence has passed. Values ending in _REFERENCE identify
# secret-manager/runtime references, never raw credentials.
COMMUNICATIONS_DELIVERY_ENABLED=false
COMMUNICATIONS_EMAIL_PROVIDER_IDENTITY=SET_AFTER_OWNER_PROVIDER_SELECTION
COMMUNICATIONS_EMAIL_CREDENTIAL_REFERENCE=SET_TO_PREVIEW_SECRET_REFERENCE
COMMUNICATIONS_EMAIL_SENDER_IDENTITY=SET_TO_VERIFIED_PREVIEW_FROM_IDENTITY
COMMUNICATIONS_EMAIL_SENDER_VERIFIED=false
COMMUNICATIONS_EMAIL_DOMAIN_VERIFIED=false
COMMUNICATIONS_SMS_PROVIDER_IDENTITY=SET_AFTER_OWNER_PROVIDER_SELECTION
COMMUNICATIONS_SMS_CREDENTIAL_REFERENCE=SET_TO_PREVIEW_SECRET_REFERENCE
COMMUNICATIONS_SMS_SENDER_IDENTITY=SET_TO_VERIFIED_PREVIEW_SENDER
COMMUNICATIONS_SMS_REGISTRATION_VERIFIED=false
COMMUNICATIONS_WEBHOOK_SECRET_REFERENCE=SET_TO_PREVIEW_WEBHOOK_SECRET_REFERENCE
COMMUNICATIONS_WEBHOOK_ENABLED=false

# QBO sandbox OAuth callback. Client credentials and tokens are files in the
# protected runtime volume, never environment values or repository content.
QBO_SANDBOX_ENABLED=true
QBO_SANDBOX_CALLBACK_URI=https://preview.allcountyhomeservices.com/api/v1/integrations/qbo/oauth/callback
QBO_SANDBOX_RUNTIME_ROOT=/var/lib/acp-qbo-sandbox
QBO_REPOSITORY_ROOT=/app
QBO_SANDBOX_API_MINOR_VERSION=75

# Persistent authenticated worker. Keep the key outside the repository and 0600.
# Enable engineering.execute only after provisioning the same bounded capability.
ACP_WORKER_ID=00000000-0000-0000-0000-000000000000
ACP_WORKER_PRIVATE_KEY_FILE_HOST=/opt/acp-enterprise/shared/secrets/preview-worker.key
ACP_WORKER_SECRET_DIRECTORY_HOST=/opt/acp-enterprise/shared/secrets/worker-preview
ACP_WORKER_CAPABILITIES=transport.connectivity
ACP_WORKER_WORKSPACE_ROOT_HOST=/opt/acp-enterprise/shared/worker-workspaces
ACP_WORKER_WORKSPACE_ROOT_CONTAINER=/workspace
ACP_WORKER_SERVICE_VERSION=SET_TO_DEPLOYED_COMMIT
ACP_WORKER_COMPANY_CODE=SET_PREVIEW_COMPANY_CODE
ACP_WORKER_ADMINISTRATOR_EMAIL=SET_PREVIEW_ADMINISTRATOR_EMAIL
ACP_WORKER_NAME=ACP Preview Engineering Worker
ACP_WORKER_PROVIDER_IDENTIFIER=connectivity
ACP_WORKER_CREDENTIAL_DAYS=30

# Secure defaults required by preview configuration validation.
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
