FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Mission Control remains a same-origin application. Only its static asset
# namespace differs from the primary ACP artifact.
ENV VITE_API_BASE_URL=/
ENV VITE_BASE_PATH=/mission-assets/

RUN npm run build:mission-control

FROM nginx:1.29-alpine AS runtime

COPY nginx.preview.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=6 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/healthz || exit 1
