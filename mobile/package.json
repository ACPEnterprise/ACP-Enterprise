{
  "name": "acp-employee-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "export": "expo export --platform ios --output-dir dist/ios && expo export --platform android --output-dir dist/android",
    "config:validate": "tsx scripts/validate-config.ts",
    "beta:aasa": "tsx scripts/beta-aasa.ts",
    "beta:fixture": "tsx scripts/beta-fixture.ts",
    "beta:manifest": "tsx scripts/beta-manifest.ts",
    "beta:preflight": "tsx scripts/beta-preflight.ts",
    "beta:qualify": "bash scripts/beta-release-qualify.sh",
    "apple:preflight": "tsx scripts/apple-distribution-preflight.ts",
    "apple:archive:qualify": "bash scripts/apple-archive-qualify.sh"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "expo": "~57.0.19",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
