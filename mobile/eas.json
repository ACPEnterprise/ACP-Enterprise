{
  "cli": {"version": ">= 16.0.0", "appVersionSource": "local"},
  "build": {
    "development": {"developmentClient": true, "distribution": "internal", "channel": "development"},
    "preview": {"distribution": "internal", "channel": "preview", "env": {"EXPO_PUBLIC_APP_ENV": "preview"}},
    "production": {"channel": "production", "autoIncrement": true, "env": {"EXPO_PUBLIC_APP_ENV": "production"}}
  }
}
