#!/usr/bin/env python3
"""Deterministic Enterprise release qualification runner.

The runner never deploys or merges. It executes only the checks selected by the
requested profile and records every other check as NOT YET EXECUTED, BLOCKED,
or NOT APPLICABLE in a sealed JSON packet.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Final

STATUSES: Final = {"PASS", "FAIL", "BLOCKED", "NOT APPLICABLE", "NOT YET EXECUTED"}
CONTRACT: Final = "enterprise-release-qualification/v3"
SEAL_CONTRACT: Final = "enterprise-release-evidence-seal/v1"
SCHEMA_PATH: Final = Path("docs/release/enterprise-release-qualification.schema.json")
PROTECTED_RUNTIME_SERVICES: Final = {
    "api_health": "backend",
    "database_security": "database-security",
    "postgres_health": "postgres",
    "redis_health": "redis",
}


@dataclass(frozen=True)
class Check:
    key: str
    title: str
    profiles: tuple[str, ...]
    command: tuple[str, ...] | None
    expected: str
    required_tools: tuple[str, ...] = ()
    mutation: str = "none"


@dataclass(frozen=True)
class Result:
    key: str
    title: str
    status: str
    command: str | None
    expected: str
    exit_code: int | None
    duration_seconds: float | None
    artifact: str | None
    artifact_sha256: str | None
    reason: str | None
    skipped_count: int | None
    failed_count: int | None = None
    warnings: tuple[str, ...] = ()


