def canonical(value: object) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def tool_available(tool: str) -> bool:
    if tool == sys.executable:
        return sys.version_info >= (3, 12) and Path(tool).is_file()
    return shutil.which(tool) is not None


def count_skips(output: str) -> int | None:
    values = [int(value) for value in re.findall(r"(\d+) skipped", output)]
    return sum(values) if values else 0


def count_failures(output: str) -> int | None:
    values = [int(value) for value in re.findall(r"(\d+) failed", output)]
    return sum(values) if values else 0


def test_output_warnings(check_key: str, output: str) -> tuple[str, ...]:
    if not check_key.endswith("_tests"):
        return ()
    warning_patterns = (
        (r"(?m)^stderr\s*\|", "test suite emitted stderr"),
        (r"(?m)^\s*console\.(?:error|warn)\b", "test suite emitted console output"),
        (r"\bWarning:", "test suite emitted a runtime warning"),
        (r"not configured to support act\(\.\.\.\)", "React updates escaped act"),
        (r"HydrateFallback", "router hydration fallback is missing"),
    )
    return tuple(
        reason for pattern, reason in warning_patterns if re.search(pattern, output)
    )


def test_output_warning(check_key: str, output: str) -> str | None:
    """Backward-compatible first warning used by focused qualification tests."""
    warnings = test_output_warnings(check_key, output)
    return warnings[0] if warnings else None


def redact_output(output: str, environment: dict[str, str] | None = None) -> str:
    """Remove secret values from captured command output before persistence."""
    redacted = output
    source = environment if environment is not None else dict(os.environ)
    secret_name = re.compile(
        r"(?:password|passwd|secret|token|credential|private[_-]?key|api[_-]?key)",
        re.IGNORECASE,
    )
    values = sorted(
        {
            value
            for name, value in source.items()
            if secret_name.search(name) and len(value) >= 8
        },
        key=len,
        reverse=True,
    )
    for value in values:
        redacted = redacted.replace(value, "[REDACTED]")
    redacted = re.sub(
        r"(?i)([a-z][a-z0-9+.-]*://[^\s:/@]+:)[^\s@]+(@)",
        r"\1[REDACTED]\2",
        redacted,
    )
    redacted = re.sub(
        r"(?i)(\b[A-Z0-9_]*(?:PASSWORD|PASSWD|SECRET|TOKEN|CREDENTIAL|PRIVATE_KEY|API_KEY)[A-Z0-9_]*\s*[=:]\s*)[^\s,;]+",
        r"\1[REDACTED]",
        redacted,
    )
    redacted = re.sub(
        r'(?i)(["\'](?:password|passwd|secret|token|credential|private_key|api_key)["\']\s*:\s*)["\'][^"\']*["\']',
        r'\1"[REDACTED]"',
        redacted,
    )
    return redacted


def prepare_evidence_directory(path: Path) -> None:
    """Create a private, empty evidence directory without altering sealed output."""
    if path.is_symlink():
        raise SystemExit("evidence directory must not be a symbolic link")
    if path.exists():
        if not path.is_dir():
            raise SystemExit("evidence path must be a directory")
        if any(path.iterdir()):
            raise SystemExit("evidence directory must be empty")
    else:
        path.mkdir(mode=0o700, parents=True)
    path.chmod(0o700)


def write_private_artifact(path: Path, content: str) -> None:
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        stream.write(content)


def run_command(
    check: Check,
    root: Path,
    artifact: Path,
    candidate: str,
    tooling_sha: str | None = None,
) -> Result:
    assert check.command is not None
    missing = [tool for tool in check.required_tools if not tool_available(tool)]
    reason: str | None = None
    if missing:
        reason = "required supported tool unavailable: " + ", ".join(missing)
        if sys.executable in missing:
            reason += f" (observed Python {sys.version.split()[0]}; repository image uses Python 3.12)"
        return Result(
            check.key,
            check.title,
            "BLOCKED",
            shlex.join(check.command),
            check.expected,
            None,
            None,
            None,
            None,
            reason,
            None,
        )
    started = time.monotonic()
    environment = dict(os.environ)
    backend_root = str(root / "backend")
    import_roots = environment.get("PYTHONPATH", "").split(os.pathsep)
    if backend_root not in import_roots:
        environment["PYTHONPATH"] = os.pathsep.join(
            (backend_root, *(path for path in import_roots if path))
        )
    try:
        completed = subprocess.run(
            check.command,
            cwd=root,
            env=environment,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
        )
        returncode = completed.returncode
        raw_output = completed.stdout
    except (OSError, subprocess.SubprocessError) as error:
        returncode = None
        raw_output = f"subprocess execution failed: {type(error).__name__}: {error}\n"
        reason = "subprocess could not be executed"
    duration = time.monotonic() - started
    output = redact_output(raw_output, environment)
    write_private_artifact(artifact, output)
    if returncode is None:
        return Result(
            check.key,
            check.title,
            "FAIL",
            shlex.join(check.command),
            check.expected,
            None,
            duration,
            artifact.name,
            hashlib.sha256(artifact.read_bytes()).hexdigest(),
            reason,
            None,
        )
    status = "PASS" if returncode == 0 else "FAIL"
    warnings = test_output_warnings(check.key, raw_output)
    if status == "PASS" and warnings:
        status, reason = "FAIL", warnings[0]
    if check.key == "repository_cleanliness" and raw_output:
        status, reason = "FAIL", "working tree is not clean"
    if check.key == "repository_provenance" and raw_output.strip() != (tooling_sha or candidate):
        status, reason = "FAIL", "HEAD does not equal candidate SHA"
    if check.key == "migration_heads" and status == "PASS":
        try:
            lineage = json.loads(raw_output)
            valid_lineage = (
                lineage.get("release_ready") is True
                and len(lineage.get("roots", [])) == 1
                and len(lineage.get("heads", [])) == 1
                and lineage.get("risks") == []
            )
        except (json.JSONDecodeError, AttributeError, TypeError):
            valid_lineage = False
        if not valid_lineage:
            status, reason = "FAIL", "canonical migration lineage is not release-ready"
    artifact_sha256 = hashlib.sha256(artifact.read_bytes()).hexdigest()
    return Result(
        check.key,
        check.title,
        status,
        shlex.join(check.command),
        check.expected,
        returncode,
        duration,
        artifact.name,
        artifact_sha256,
        reason,
        count_skips(raw_output),
        count_failures(raw_output),
        warnings,
    )


def placeholder(check: Check, status: str, reason: str) -> Result:
    return Result(
        check.key,
        check.title,
        status,
        shlex.join(check.command) if check.command else None,
        check.expected,
        None,
        None,
        None,
        None,
        reason,
        None,
    )


def qualification_decision(results: list[Result], *, executed: bool) -> str:
    statuses = {result.status for result in results}
    if "FAIL" in statuses:
        return "FAIL"
    if "BLOCKED" in statuses:
        return "BLOCKED"
    if executed:
        return "PASS"
    return "NOT YET EXECUTED"


def receipt_digest(path: Path | None) -> str | None:
    if path is None or not path.is_file():
        return None
    return hashlib.sha256(path.read_bytes()).hexdigest()


def rollback_readiness(
    backup: Path | None,
    restore: Path | None,
    expected_backup: str | None,
    expected_restore: str | None,
) -> tuple[str, str]:
    observed = (receipt_digest(backup), receipt_digest(restore))
    expected = (expected_backup, expected_restore)
    if any(value is None for value in observed):
        return "BLOCKED", "backup and verified restore receipt files are required"
    if any(value is None for value in expected):
        return (
            "BLOCKED",
            "authority-bound backup and restore receipt digests are required",
        )
    if observed != expected:
        return (
            "FAIL",
            "backup or restore receipt digest does not match release authority",
        )
    return "PASS", "backup and verified restore receipts match release authority"


def packet_digest(packet: dict[str, object]) -> str:
    payload = {key: value for key, value in packet.items() if key != "digest"}
    return hashlib.sha256(canonical(payload)).hexdigest()


def validate_packet(packet: dict[str, object], root: Path) -> None:
    """Validate the evidence contract before it can be sealed."""
    schema_path = root / SCHEMA_PATH
    schema = json.loads(schema_path.read_text(encoding="utf-8"))
    if schema.get("$id") != CONTRACT:
        raise ValueError("qualification evidence schema ID does not match contract")
    required = set(schema.get("required", ()))
    if required != set(packet):
        missing = sorted(required - set(packet))
        extra = sorted(set(packet) - required)
        raise ValueError(
            f"packet fields do not match schema; missing={missing}, extra={extra}"
        )
    if packet["contract"] != CONTRACT:
        raise ValueError("packet contract is invalid")
    if not isinstance(packet["candidate_sha"], str) or not re.fullmatch(
        r"[0-9a-f]{40}", packet["candidate_sha"]
    ):
        raise ValueError("packet candidate SHA is invalid")
    if packet["application_sha"] != packet["candidate_sha"]:
        raise ValueError("application SHA and candidate SHA differ")
    for field in ("tooling_sha", "protected_baseline_sha"):
        if not isinstance(packet[field], str) or not re.fullmatch(
            r"[0-9a-f]{40}", packet[field]
        ):
            raise ValueError(f"packet {field} is invalid")
    if not isinstance(packet["observed_head"], str) or not re.fullmatch(
        r"[0-9a-f]{40}", packet["observed_head"]
    ):
        raise ValueError("packet observed HEAD is invalid")
    if packet["deployment_authorized"] is not False:
        raise ValueError("qualification evidence may not authorize deployment")
    if packet["release_decision"] not in STATUSES - {"NOT APPLICABLE"}:
        raise ValueError("release decision is invalid")
    results = packet["results"]
    if not isinstance(results, list) or not results:
        raise ValueError("qualification packet requires results")
    result_fields = set(Result.__dataclass_fields__)
    keys: list[str] = []
    for result in results:
        if not isinstance(result, dict) or set(result) != result_fields:
            raise ValueError("result fields do not match schema")
        if result["status"] not in STATUSES:
            raise ValueError("result status is invalid")
        if not isinstance(result["key"], str) or not result["key"]:
            raise ValueError("result key is invalid")
        keys.append(result["key"])
        artifact = result["artifact"]
        artifact_digest = result["artifact_sha256"]
        if (artifact is None) != (artifact_digest is None):
            raise ValueError("artifact and digest must be present together")
        if artifact is not None and (
            not isinstance(artifact, str)
            or not isinstance(artifact_digest, str)
            or Path(artifact).name != artifact
            or not re.fullmatch(r"[0-9a-f]{64}", artifact_digest)
        ):
            raise ValueError("artifact binding is invalid")
    if len(keys) != len(set(keys)):
        raise ValueError("result keys must be unique")
    observed_counts = {
        status: sum(result["status"] == status for result in results)
        for status in sorted(STATUSES)
    }
    if packet["status_counts"] != observed_counts:
        raise ValueError("status counts do not match results")
    schema_binding = packet["schema"]
    if not isinstance(schema_binding, dict) or schema_binding != {
        "path": str(SCHEMA_PATH),
        "sha256": hashlib.sha256(schema_path.read_bytes()).hexdigest(),
    }:
        raise ValueError("schema binding is invalid")
    if packet["digest"] != packet_digest(packet):
        raise ValueError("packet digest does not match canonical packet")


def seal_evidence(directory: Path, packet: dict[str, object]) -> dict[str, object]:
    artifacts: list[dict[str, object]] = []
    for path in sorted(directory.iterdir(), key=lambda item: item.name):
        if path.name == "evidence-seal.json":
            continue
        if not path.is_file() or path.is_symlink():
            raise ValueError(f"evidence artifact is not a regular file: {path.name}")
        if path.stat().st_mode & 0o077:
            raise ValueError(f"evidence artifact is not private: {path.name}")
        content = path.read_bytes()
        artifacts.append(
            {
                "path": path.name,
                "sha256": hashlib.sha256(content).hexdigest(),
                "size_bytes": len(content),
            }
        )
    referenced = {
        result["artifact"]
        for result in packet["results"]
        if result["artifact"] is not None
    }
    observed = {artifact["path"] for artifact in artifacts}
    if not referenced <= observed or "qualification-packet.json" not in observed:
        raise ValueError("sealed artifacts do not contain every packet reference")
    observed_digests = {artifact["path"]: artifact["sha256"] for artifact in artifacts}
    for result in packet["results"]:
        if (
            result["artifact"] is not None
            and observed_digests[result["artifact"]] != result["artifact_sha256"]
        ):
            raise ValueError(f"packet artifact digest mismatch: {result['artifact']}")
    seal: dict[str, object] = {
        "contract": SEAL_CONTRACT,
        "candidate_sha": packet["candidate_sha"],
        "profile": packet["profile"],
        "packet_digest": packet["digest"],
        "artifacts": artifacts,
    }
    seal["digest"] = hashlib.sha256(canonical(seal)).hexdigest()
    write_private_artifact(
        directory / "evidence-seal.json",
        json.dumps(seal, indent=2, sort_keys=True) + "\n",
    )
    return seal


def verify_evidence_seal(directory: Path, root: Path) -> dict[str, object]:
    packet = json.loads((directory / "qualification-packet.json").read_text())
    validate_packet(packet, root)
    seal = json.loads((directory / "evidence-seal.json").read_text())
    supplied_digest = seal.pop("digest", None)
    if supplied_digest != hashlib.sha256(canonical(seal)).hexdigest():
        raise ValueError("evidence seal digest does not match")
    if (
        seal.get("contract") != SEAL_CONTRACT
        or seal.get("candidate_sha") != packet["candidate_sha"]
        or seal.get("profile") != packet["profile"]
        or seal.get("packet_digest") != packet["digest"]
    ):
        raise ValueError("evidence seal provenance does not match packet")
    sealed_paths = [artifact["path"] for artifact in seal["artifacts"]]
    observed_paths = sorted(
        path.name for path in directory.iterdir() if path.name != "evidence-seal.json"
    )
    if sorted(sealed_paths) != observed_paths or len(sealed_paths) != len(
        set(sealed_paths)
    ):
        raise ValueError("evidence seal artifact inventory does not match directory")
    for artifact in seal["artifacts"]:
        path = directory / artifact["path"]
        if path.is_symlink() or not path.is_file():
            raise ValueError("sealed artifact is missing or unsafe")
        content = path.read_bytes()
        if artifact["sha256"] != hashlib.sha256(content).hexdigest():
            raise ValueError(f"sealed artifact digest mismatch: {path.name}")
        if artifact["size_bytes"] != len(content):
            raise ValueError(f"sealed artifact size mismatch: {path.name}")
        if path.stat().st_mode & 0o077:
            raise ValueError(f"sealed artifact is not private: {path.name}")
    seal["digest"] = supplied_digest
    return seal


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--profile",
        choices=("plan", "local", "database", "preview", "postdeploy", "commissioning"),
        default="plan",
    )
    parser.add_argument("--candidate-sha")
    parser.add_argument("--tooling-sha")
    parser.add_argument("--protected-baseline-sha")
    parser.add_argument("--preview-revision")
    parser.add_argument("--preview-url")
    parser.add_argument("--backup-receipt", type=Path)
    parser.add_argument("--restore-receipt", type=Path)
    parser.add_argument("--expected-backup-receipt-sha256")
    parser.add_argument("--expected-restore-receipt-sha256")
    parser.add_argument("--approval-artifact", type=Path)
    parser.add_argument("--trusted-issuer-key", type=Path)
    parser.add_argument("--trusted-issuer-key-id")
    parser.add_argument("--migration-head")
    parser.add_argument("--rollback-target-sha")
    parser.add_argument("--rollback-target-release")
    parser.add_argument("--protected-runtime-root", type=Path)
    parser.add_argument("--protected-runtime-project")
    parser.add_argument("--runtime-sha")
    parser.add_argument("--runtime-schema-head")
    parser.add_argument("--evidence-dir", type=Path, required=True)
    parser.add_argument("--execute", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    root = Path(__file__).resolve().parents[1]
    head = subprocess.check_output(
        ("git", "rev-parse", "HEAD"), cwd=root, text=True
    ).strip()
    candidate = args.candidate_sha or head
    tooling_sha = args.tooling_sha or head
    baseline_sha = args.protected_baseline_sha
    if not re.fullmatch(r"[0-9a-f]{40}", candidate):
        raise SystemExit("candidate SHA must be a full 40-character lowercase SHA")
    if not re.fullmatch(r"[0-9a-f]{40}", tooling_sha):
        raise SystemExit("tooling SHA must be a full 40-character lowercase SHA")
    if tooling_sha != head:
        raise SystemExit("tooling SHA must equal the executing repository HEAD")
    if args.execute and not re.fullmatch(r"[0-9a-f]{40}", baseline_sha or ""):
        raise SystemExit("executed qualification requires --protected-baseline-sha")
    if baseline_sha is None:
        baseline_sha = head
    if not re.fullmatch(r"[0-9a-f]{40}", baseline_sha):
        raise SystemExit("protected baseline SHA must be a full 40-character lowercase SHA")
    resolved_application = subprocess.run(
        ("git", "rev-parse", "--verify", f"{candidate}^{{commit}}"),
        cwd=root,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if resolved_application.returncode != 0 or resolved_application.stdout.strip() != candidate:
        raise SystemExit("application candidate SHA is not independently resolvable")
    prepare_evidence_directory(args.evidence_dir)
    results: list[Result] = []
    for check in checks():
        artifact = args.evidence_dir / f"{check.key}.log"
        if args.profile == "plan":
            results.append(placeholder(check, "NOT YET EXECUTED", "plan-only packet"))
        elif args.profile not in check.profiles:
            results.append(
                placeholder(
                    check,
                    "NOT YET EXECUTED",
                    f"owned by profile(s): {', '.join(check.profiles)}",
                )
            )
        elif not args.execute:
            results.append(
                placeholder(check, "NOT YET EXECUTED", "execution flag not supplied")
            )
        elif check.command is not None:
            results.append(run_command(check, root, artifact, candidate, tooling_sha))
        elif check.key == "rollback_readiness":
            receipt_status, receipt_reason = rollback_readiness(
                args.backup_receipt,
                args.restore_receipt,
                args.expected_backup_receipt_sha256,
                args.expected_restore_receipt_sha256,
            )
            results.append(placeholder(check, receipt_status, receipt_reason))
        elif check.key == "preview_approval":
            required = (
                args.approval_artifact,
                args.trusted_issuer_key,
                args.trusted_issuer_key_id,
                args.migration_head,
                args.expected_backup_receipt_sha256,
                args.expected_restore_receipt_sha256,
                args.rollback_target_sha,
                args.rollback_target_release,
            )
            if any(value is None for value in required):
                results.append(
                    placeholder(
                        check,
                        "BLOCKED",
                        "Enterprise-signed approval artifact and complete expected bindings are required",
                    )
                )
            else:
                approval_check = Check(
                    check.key,
                    check.title,
                    check.profiles,
                    (
                        sys.executable,
                        "scripts/validate-preview-approval.py",
                        "--artifact",
                        str(args.approval_artifact),
                        "--trusted-issuer-key",
                        str(args.trusted_issuer_key),
                        "--trusted-key-id",
                        str(args.trusted_issuer_key_id),
                        "--candidate-sha",
                        candidate,
                        "--migration-head",
                        str(args.migration_head),
                        "--backup-receipt-sha256",
                        str(args.expected_backup_receipt_sha256),
                        "--restore-receipt-sha256",
                        str(args.expected_restore_receipt_sha256),
                        "--rollback-target-sha",
                        str(args.rollback_target_sha),
                        "--rollback-target-release",
                        str(args.rollback_target_release),
                    ),
                    check.expected,
                    (sys.executable,),
                )
                results.append(run_command(approval_check, root, artifact, candidate, tooling_sha))
        elif check.key in {
            "api_health",
            "postdeploy_routes",
            "authentication_smoke",
            "authorization_smoke",
            "background_services",
            "postgres_health",
            "redis_health",
            "database_security",
        }:
            if (
                args.protected_runtime_root
                and args.protected_runtime_project
                and args.runtime_sha
                and args.runtime_schema_head
            ):
                service = PROTECTED_RUNTIME_SERVICES.get(check.key)
                if service is None:
                    results.append(
                        placeholder(check, "BLOCKED", "no protected implementation is registered for this check")
                    )
                    continue
                runtime_check = Check(
                    check.key,
                    check.title,
                    check.profiles,
                    (
                        sys.executable,
                        "scripts/protected-runtime-check.py",
                        "--runtime-root",
                        str(args.protected_runtime_root),
                        "--project",
                        args.protected_runtime_project,
                        "--service",
                        service,
                        "--expected-sha",
                        args.runtime_sha,
                        "--expected-schema-head",
                        args.runtime_schema_head,
                    ),
                    check.expected,
                    (sys.executable,),
                )
                results.append(run_command(runtime_check, root, artifact, candidate, tooling_sha))
            else:
                results.append(
                    placeholder(
                        check,
                        "BLOCKED",
                        "protected runtime root, project, SHA, and schema head are required",
                    )
                )
        elif check.key == "critical_crud":
            results.append(
                placeholder(
                    check,
                    "BLOCKED",
                    "requires approved disposable non-production tenant and explicit mutation authority",
                )
            )
        else:
            results.append(
                placeholder(check, "BLOCKED", "required external evidence not supplied")
            )

    status_counts = {
        status: sum(result.status == status for result in results)
        for status in sorted(STATUSES)
    }
    receipts = {}
    for name, path in (
        ("backup", args.backup_receipt),
        ("restore", args.restore_receipt),
    ):
        if path and path.is_file():
            receipts[name] = {
                "path": str(path),
                "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            }
    decision = qualification_decision(results, executed=args.execute)
    packet = {
        "contract": CONTRACT,
        "candidate_sha": candidate,
        "application_sha": candidate,
        "tooling_sha": tooling_sha,
        "protected_baseline_sha": baseline_sha,
        "observed_head": head,
        "profile": args.profile,
        "executed": args.execute,
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "preview_revision": args.preview_revision or "NOT YET RECORDED",
        "preview_url": args.preview_url or "NOT YET RECORDED",
        "results": [asdict(result) for result in results],
        "status_counts": status_counts,
        "rollback_receipts": receipts,
        "schema": {
            "path": str(SCHEMA_PATH),
            "sha256": hashlib.sha256((root / SCHEMA_PATH).read_bytes()).hexdigest(),
        },
        "release_decision": decision,
        "deployment_authorized": False,
    }
    packet["digest"] = packet_digest(packet)
    validate_packet(packet, root)
    packet_path = args.evidence_dir / "qualification-packet.json"
    descriptor = os.open(packet_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "wb") as stream:
        stream.write(json.dumps(packet, indent=2, sort_keys=True).encode() + b"\n")
    seal = seal_evidence(args.evidence_dir, packet)
    verify_evidence_seal(args.evidence_dir, root)
    print(
        json.dumps(
            {
                "packet": str(packet_path),
                "digest": packet["digest"],
                "seal_digest": seal["digest"],
                "decision": packet["release_decision"],
                "status_counts": status_counts,
            },
            sort_keys=True,
        )
    )
    return 1 if decision in {"FAIL", "BLOCKED"} else 0


if __name__ == "__main__":
    raise SystemExit(main())
