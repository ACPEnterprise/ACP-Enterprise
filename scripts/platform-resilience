#!/usr/bin/env python3
"""Fail-closed non-Production backup, restore, and release verification."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import unquote, urlsplit

ALLOWED_ENVIRONMENTS = {"development", "test", "preview-isolated"}
RESTORE_RECEIPT_CONTRACT = "platform-resilience.restore-receipt.v2"
os.umask(0o077)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def canonical(payload: dict[str, object]) -> bytes:
    return json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()


def payload_digest(payload: dict[str, object]) -> str:
    return hashlib.sha256(canonical(payload)).hexdigest()


def require_private_destination(path: Path) -> Path:
    path = path.resolve()
    if not path.parent.exists():
        path.parent.mkdir(mode=0o700, parents=True)
    if stat.S_IMODE(path.parent.stat().st_mode) & 0o077:
        raise ValueError("Evidence directory permissions are not restrictive.")
    if path.exists():
        raise ValueError("Refusing to overwrite an existing evidence receipt.")
    return path


def write_private_json(path: Path, payload: dict[str, object]) -> None:
    """Atomically publish evidence without exposing a partial receipt."""
    path = require_private_destination(path)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        with temporary.open("x", encoding="utf-8") as stream:
            json.dump(payload, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        temporary.chmod(0o600)
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def load_restore_receipt(path: Path) -> dict[str, object]:
    if not path.is_file() or path.is_symlink():
        raise ValueError("Restore receipt must be a regular file.")
    if stat.S_IMODE(path.stat().st_mode) & 0o077:
        raise ValueError("Restore receipt permissions are not restrictive.")
    try:
        receipt = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise ValueError("Restore receipt is not valid JSON.") from error
    if receipt.get("contract") != RESTORE_RECEIPT_CONTRACT:
        raise ValueError("Unsupported restore receipt contract.")
    recorded_digest = receipt.get("digest")
    unsigned = {key: value for key, value in receipt.items() if key != "digest"}
    if recorded_digest != payload_digest(unsigned):
        raise ValueError("Restore receipt digest does not match its payload.")
    if receipt.get("environment") not in ALLOWED_ENVIRONMENTS:
        raise ValueError("Restore receipt environment is not approved.")
    if receipt.get("target_was_empty") is not True:
        raise ValueError("Restore receipt does not prove an empty target.")
    if not str(receipt.get("target_identity", "")).startswith("isolated-"):
        raise ValueError("Restore receipt target identity is not isolated.")
    if not str(receipt.get("database_name", "")).startswith("acp_resilience_restore"):
        raise ValueError("Restore receipt database identity is not isolated.")
    if not re.fullmatch(r"[0-9a-f]{64}", str(receipt.get("source_sha256", ""))):
        raise ValueError("Restore receipt source digest is invalid.")
    return receipt


def database_parts(url: str) -> tuple[list[str], dict[str, str]]:
    parsed = urlsplit(url.replace("postgresql+asyncpg://", "postgresql://", 1))
    if parsed.scheme not in {"postgres", "postgresql"} or not parsed.hostname:
        raise ValueError("A PostgreSQL URL with an explicit host is required.")
    database = parsed.path.removeprefix("/")
    if not database:
        raise ValueError("The PostgreSQL URL must name a database.")
    args = ["--host", parsed.hostname, "--port", str(parsed.port or 5432)]
    if parsed.username:
        args += ["--username", unquote(parsed.username)]
    return args + ["--dbname", database], {
        **os.environ,
        "PGPASSWORD": unquote(parsed.password or ""),
    }


def database_name(url: str) -> str:
    parsed = urlsplit(url.replace("postgresql+asyncpg://", "postgresql://", 1))
    return parsed.path.removeprefix("/")


def require_nonproduction(environment: str) -> None:
    if environment not in ALLOWED_ENVIRONMENTS:
        raise ValueError(
            f"Environment {environment!r} is not an approved isolated qualification target."
        )


def run(command: list[str], *, environment: dict[str, str] | None = None) -> str:
    result = subprocess.run(
        command,
        check=True,
        env=environment,
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def backup(args: argparse.Namespace) -> None:
    require_nonproduction(args.environment)
    output = Path(args.output).resolve()
    output.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    output.parent.chmod(0o700)
    if output.exists():
        raise ValueError("Refusing to overwrite an existing backup.")
    connection, environment = database_parts(args.database_url)
    run(
        [
            "pg_dump",
            *connection,
            "--format=custom",
            "--no-owner",
            "--file",
            str(output),
        ],
        environment=environment,
    )
    output.chmod(0o600)
    manifest = {
        "contract_version": "platform-resilience.backup.v1",
        "environment": args.environment,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "authority_sha": args.authority_sha,
        "schema_head": args.schema_head,
        "database_identity": args.database_identity,
        "format": "postgresql-custom",
        "backup_file": output.name,
        "size_bytes": output.stat().st_size,
        "sha256": sha256(output),
    }
    manifest_path = output.with_suffix(output.suffix + ".manifest.json")
    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    manifest_path.chmod(0o600)
    print(json.dumps({"result": "BACKUP_CREATED", "manifest": str(manifest_path)}))


def load_verified(backup_path: Path) -> dict[str, object]:
    manifest_path = backup_path.with_suffix(backup_path.suffix + ".manifest.json")
    if not backup_path.is_file():
        raise ValueError("Backup file is missing.")
    if not manifest_path.is_file():
        raise ValueError("Backup manifest is missing.")
    manifest = json.loads(manifest_path.read_text())
    if manifest.get("contract_version") != "platform-resilience.backup.v1":
        raise ValueError("Unsupported backup manifest contract.")
    if manifest.get("format") != "postgresql-custom":
        raise ValueError("Backup manifest format is not PostgreSQL custom.")
    if manifest.get("backup_file") != backup_path.name:
        raise ValueError("Backup filename does not match its manifest.")
    if manifest.get("size_bytes") != backup_path.stat().st_size:
        raise ValueError("Backup size does not match its manifest.")
    if manifest.get("sha256") != sha256(backup_path):
        raise ValueError("Backup checksum does not match its manifest.")
    if stat.S_IMODE(backup_path.stat().st_mode) & 0o077:
        raise ValueError("Backup permissions are not restrictive.")
    if stat.S_IMODE(manifest_path.stat().st_mode) & 0o077:
        raise ValueError("Backup manifest permissions are not restrictive.")
    run(["pg_restore", "--list", str(backup_path)])
    return manifest


def verify(args: argparse.Namespace) -> None:
    manifest = load_verified(Path(args.backup).resolve())
    print(json.dumps({"result": "BACKUP_VERIFIED", "sha256": manifest["sha256"]}))


def restore(args: argparse.Namespace) -> None:
    require_nonproduction(args.environment)
    if args.environment != "preview-isolated" and not args.target_identity.startswith(
        "isolated-"
    ):
        raise ValueError("Restore target identity must begin with 'isolated-'.")
    if not database_name(args.database_url).startswith("acp_resilience_restore"):
        raise ValueError(
            "Restore database name must begin with 'acp_resilience_restore'."
        )
    backup_path = Path(args.backup).resolve()
    manifest = load_verified(backup_path)
    if manifest["environment"] == "production":
        raise ValueError("This tool does not restore Production backups.")
    if args.expected_source_identity != manifest["database_identity"]:
        raise ValueError("Backup database identity does not match the approved source.")
    receipt_path = getattr(args, "receipt", None)
    if receipt_path:
        if not args.target_identity.startswith("isolated-"):
            raise ValueError("Evidence receipts require an isolated target identity.")
        require_private_destination(Path(receipt_path))
    connection, environment = database_parts(args.database_url)
    relation_count_query = (
        "SELECT count(*) FROM pg_class c JOIN pg_namespace n "
        "ON n.oid = c.relnamespace "
        "WHERE n.nspname NOT IN ('pg_catalog','information_schema') "
        "AND c.relkind IN ('r','p','v','m','f')"
    )
    existing_relations = run(
        [
            "psql",
            *connection,
            "--tuples-only",
            "--no-align",
            "--command",
            relation_count_query,
        ],
        environment=environment,
    )
    if existing_relations != "0":
        raise ValueError("Restore target is not empty; refusing to overwrite it.")
    run(
        [
            "pg_restore",
            *connection,
            "--exit-on-error",
            "--single-transaction",
            "--no-owner",
            str(backup_path),
        ],
        environment=environment,
    )
    receipt = {
        "contract": RESTORE_RECEIPT_CONTRACT,
        "database_name": database_name(args.database_url),
        "environment": args.environment,
        "restored_at": datetime.now(timezone.utc).isoformat(),
        "source_authority_sha": manifest.get("authority_sha"),
        "source_database_identity": manifest["database_identity"],
        "source_schema_head": manifest.get("schema_head"),
        "source_sha256": manifest["sha256"],
        "target_identity": args.target_identity,
        "target_was_empty": True,
    }
    receipt["digest"] = payload_digest(receipt)
    if receipt_path:
        write_private_json(Path(receipt_path), receipt)
    print(
        json.dumps(
            {
                "result": "ISOLATED_RESTORE_COMPLETED",
                "receipt": str(Path(receipt_path).resolve()) if receipt_path else None,
                "source_sha256": manifest["sha256"],
                "target_identity": args.target_identity,
            }
        )
    )


def verify_restore_receipt(args: argparse.Namespace) -> None:
    receipt = load_restore_receipt(Path(args.receipt).resolve())
    expected = {
        "source_authority_sha": args.expected_authority_sha,
        "source_schema_head": args.expected_schema_head,
        "source_sha256": args.expected_backup_sha256,
        "target_identity": args.expected_target_identity,
    }
    mismatches = [key for key, value in expected.items() if receipt.get(key) != value]
    if mismatches:
        raise ValueError(
            "Restore receipt binding mismatch: " + ", ".join(sorted(mismatches))
        )
    print(
        json.dumps(
            {
                "result": "RESTORE_RECEIPT_VERIFIED",
                "digest": receipt["digest"],
            },
            sort_keys=True,
        )
    )


def release_check(args: argparse.Namespace) -> None:
    expected_heads = sorted(set(args.expected_schema_head))
    actual_heads = sorted(set(args.actual_schema_head))
    failures = []
    if len(expected_heads) != 1 or actual_heads != expected_heads:
        failures.append("SCHEMA_MISMATCH")
    if args.expected_backend_sha != args.actual_backend_sha:
        failures.append("BACKEND_SHA_MISMATCH")
    if args.expected_frontend_sha != args.actual_frontend_sha:
        failures.append("FRONTEND_SHA_MISMATCH")
    if args.expected_mission_control_sha != args.actual_mission_control_sha:
        failures.append("MISSION_CONTROL_SHA_MISMATCH")
    result = {
        "ready": not failures,
        "state": "HEALTHY" if not failures else "NOT_READY",
        "failures": failures,
    }
    print(json.dumps(result, sort_keys=True))
    if failures:
        raise SystemExit(2)


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser()
    commands = root.add_subparsers(required=True)
    create = commands.add_parser("backup")
    create.add_argument("--environment", required=True)
    create.add_argument("--database-url", required=True)
    create.add_argument("--database-identity", required=True)
    create.add_argument("--authority-sha", required=True)
    create.add_argument("--schema-head", required=True)
    create.add_argument("--output", required=True)
    create.set_defaults(action=backup)
    check = commands.add_parser("verify")
    check.add_argument("--backup", required=True)
    check.set_defaults(action=verify)
    recover = commands.add_parser("restore")
    recover.add_argument("--environment", required=True)
    recover.add_argument("--database-url", required=True)
    recover.add_argument("--target-identity", required=True)
    recover.add_argument("--expected-source-identity", required=True)
    recover.add_argument("--backup", required=True)
    recover.add_argument("--receipt")
    recover.set_defaults(action=restore)
    restore_receipt = commands.add_parser("verify-restore-receipt")
    restore_receipt.add_argument("--receipt", required=True)
    restore_receipt.add_argument("--expected-authority-sha", required=True)
    restore_receipt.add_argument("--expected-schema-head", required=True)
    restore_receipt.add_argument("--expected-backup-sha256", required=True)
    restore_receipt.add_argument("--expected-target-identity", required=True)
    restore_receipt.set_defaults(action=verify_restore_receipt)
    release = commands.add_parser("release-check")
    release.add_argument("--expected-backend-sha", required=True)
    release.add_argument("--actual-backend-sha", required=True)
    release.add_argument("--expected-frontend-sha", required=True)
    release.add_argument("--actual-frontend-sha", required=True)
    release.add_argument("--expected-mission-control-sha", required=True)
    release.add_argument("--actual-mission-control-sha", required=True)
    release.add_argument("--expected-schema-head", action="append", required=True)
    release.add_argument("--actual-schema-head", action="append", required=True)
    release.set_defaults(action=release_check)
    return root


def main() -> None:
    args = parser().parse_args()
    try:
        args.action(args)
    except (
        FileNotFoundError,
        json.JSONDecodeError,
        subprocess.CalledProcessError,
        ValueError,
    ) as error:
        print(json.dumps({"result": "BLOCKED", "reason": str(error)}), file=sys.stderr)
        raise SystemExit(1) from error


if __name__ == "__main__":
    main()
