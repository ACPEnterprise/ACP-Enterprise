#!/usr/bin/env python3
"""Fail-closed non-Production backup, restore, and release verification."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import stat
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import unquote, urlsplit

ALLOWED_ENVIRONMENTS = {"development", "test", "preview-isolated"}
os.umask(0o077)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def database_parts(url: str) -> tuple[list[str], dict[str, str]]:
    parsed = urlsplit(url.replace("postgresql+asyncpg://", "postgresql://", 1))
    if parsed.scheme not in {"postgres", "postgresql"} or not parsed.hostname:
        raise ValueError("A PostgreSQL URL with an explicit host is required.")
    database = parsed.path.removeprefix("/")
    if not database:
        raise ValueError("The PostgreSQL URL must name a database.")
    args = ["--host", parsed.hostname, "--port", str(parsed.port or 5432)]
    if parsed.username:
        args += ["--username", unquote(parsed.username)]
    return args + ["--dbname", database], {
        **os.environ,
        "PGPASSWORD": unquote(parsed.password or ""),
    }


def database_name(url: str) -> str:
    parsed = urlsplit(url.replace("postgresql+asyncpg://", "postgresql://", 1))
    return parsed.path.removeprefix("/")


def require_nonproduction(environment: str) -> None:
    if environment not in ALLOWED_ENVIRONMENTS:
        raise ValueError(
            f"Environment {environment!r} is not an approved isolated qualification target."
        )


def run(command: list[str], *, environment: dict[str, str] | None = None) -> str:
    result = subprocess.run(
        command,
        check=True,
        env=environment,
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def backup(args: argparse.Namespace) -> None:
    require_nonproduction(args.environment)
    output = Path(args.output).resolve()
    output.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    output.parent.chmod(0o700)
    if output.exists():
        raise ValueError("Refusing to overwrite an existing backup.")
    connection, environment = database_parts(args.database_url)
    run(
        [
            "pg_dump",
            *connection,
            "--format=custom",
            "--no-owner",
            "--file",
            str(output),
        ],
        environment=environment,
    )
    output.chmod(0o600)
    manifest = {
        "contract_version": "platform-resilience.backup.v1",
        "environment": args.environment,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "authority_sha": args.authority_sha,
        "schema_head": args.schema_head,
        "database_identity": args.database_identity,
        "format": "postgresql-custom",
        "backup_file": output.name,
        "size_bytes": output.stat().st_size,
        "sha256": sha256(output),
    }
    manifest_path = output.with_suffix(output.suffix + ".manifest.json")
    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    manifest_path.chmod(0o600)
    print(json.dumps({"result": "BACKUP_CREATED", "manifest": str(manifest_path)}))


def load_verified(backup_path: Path) -> dict[str, object]:
    manifest_path = backup_path.with_suffix(backup_path.suffix + ".manifest.json")
    manifest = json.loads(manifest_path.read_text())
    if manifest.get("contract_version") != "platform-resilience.backup.v1":
        raise ValueError("Unsupported backup manifest contract.")
    if manifest.get("sha256") != sha256(backup_path):
        raise ValueError("Backup checksum does not match its manifest.")
    if stat.S_IMODE(backup_path.stat().st_mode) & 0o077:
        raise ValueError("Backup permissions are not restrictive.")
    run(["pg_restore", "--list", str(backup_path)])
    return manifest


def verify(args: argparse.Namespace) -> None:
    manifest = load_verified(Path(args.backup).resolve())
    print(json.dumps({"result": "BACKUP_VERIFIED", "sha256": manifest["sha256"]}))


def restore(args: argparse.Namespace) -> None:
    require_nonproduction(args.environment)
    if args.environment != "preview-isolated" and not args.target_identity.startswith(
        "isolated-"
    ):
        raise ValueError("Restore target identity must begin with 'isolated-'.")
    if not database_name(args.database_url).startswith("acp_resilience_restore"):
        raise ValueError(
            "Restore database name must begin with 'acp_resilience_restore'."
        )
    backup_path = Path(args.backup).resolve()
    manifest = load_verified(backup_path)
    if manifest["environment"] == "production":
        raise ValueError("This tool does not restore Production backups.")
    if args.expected_source_identity != manifest["database_identity"]:
        raise ValueError("Backup database identity does not match the approved source.")
    connection, environment = database_parts(args.database_url)
    run(
        [
            "pg_restore",
            *connection,
            "--exit-on-error",
            "--single-transaction",
            "--no-owner",
            str(backup_path),
        ],
        environment=environment,
    )
    print(
        json.dumps(
            {
                "result": "ISOLATED_RESTORE_COMPLETED",
                "source_sha256": manifest["sha256"],
                "target_identity": args.target_identity,
            }
        )
    )


def release_check(args: argparse.Namespace) -> None:
    expected_heads = sorted(set(args.expected_schema_head))
    actual_heads = sorted(set(args.actual_schema_head))
    failures = []
    if len(expected_heads) != 1 or actual_heads != expected_heads:
        failures.append("SCHEMA_MISMATCH")
    if args.expected_backend_sha != args.actual_backend_sha:
        failures.append("BACKEND_SHA_MISMATCH")
    if args.expected_frontend_sha != args.actual_frontend_sha:
        failures.append("FRONTEND_SHA_MISMATCH")
    if args.expected_mission_control_sha != args.actual_mission_control_sha:
        failures.append("MISSION_CONTROL_SHA_MISMATCH")
    result = {
        "ready": not failures,
        "state": "HEALTHY" if not failures else "NOT_READY",
        "failures": failures,
    }
    print(json.dumps(result, sort_keys=True))
    if failures:
        raise SystemExit(2)


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser()
    commands = root.add_subparsers(required=True)
    create = commands.add_parser("backup")
    create.add_argument("--environment", required=True)
    create.add_argument("--database-url", required=True)
    create.add_argument("--database-identity", required=True)
    create.add_argument("--authority-sha", required=True)
    create.add_argument("--schema-head", required=True)
    create.add_argument("--output", required=True)
    create.set_defaults(action=backup)
    check = commands.add_parser("verify")
    check.add_argument("--backup", required=True)
    check.set_defaults(action=verify)
    recover = commands.add_parser("restore")
    recover.add_argument("--environment", required=True)
    recover.add_argument("--database-url", required=True)
    recover.add_argument("--target-identity", required=True)
    recover.add_argument("--expected-source-identity", required=True)
    recover.add_argument("--backup", required=True)
    recover.set_defaults(action=restore)
    release = commands.add_parser("release-check")
    release.add_argument("--expected-backend-sha", required=True)
    release.add_argument("--actual-backend-sha", required=True)
    release.add_argument("--expected-frontend-sha", required=True)
    release.add_argument("--actual-frontend-sha", required=True)
    release.add_argument("--expected-mission-control-sha", required=True)
    release.add_argument("--actual-mission-control-sha", required=True)
    release.add_argument("--expected-schema-head", action="append", required=True)
    release.add_argument("--actual-schema-head", action="append", required=True)
    release.set_defaults(action=release_check)
    return root


def main() -> None:
    args = parser().parse_args()
    try:
        args.action(args)
    except (
        FileNotFoundError,
        json.JSONDecodeError,
        subprocess.CalledProcessError,
        ValueError,
    ) as error:
        print(json.dumps({"result": "BLOCKED", "reason": str(error)}), file=sys.stderr)
        raise SystemExit(1) from error


if __name__ == "__main__":
    main()
