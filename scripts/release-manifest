#!/usr/bin/env python3
"""Generate or independently verify an immutable release manifest."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPOSITORY_ROOT / "backend"))

from development_factory.release_manifest import (
    ARTIFACT_ROLES,
    ReleaseManifestError,
    generate_release_manifest,
    safe_error,
    verify_release_manifest,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)

    generate = commands.add_parser("generate")
    _add_bindings(generate, required=True)
    generate.add_argument("--root", type=Path, required=True)
    generate.add_argument("--output", type=Path, required=True)
    for role in ARTIFACT_ROLES:
        generate.add_argument(f"--{role}-artifact", type=Path, required=True)

    verify = commands.add_parser("verify")
    _add_bindings(verify, required=False)
    verify.add_argument("--root", type=Path, required=True)
    verify.add_argument("--manifest", type=Path, required=True)
    return parser


def _add_bindings(parser: argparse.ArgumentParser, *, required: bool) -> None:
    parser.add_argument("--candidate-sha", required=required)
    parser.add_argument("--tooling-sha", required=required)
    parser.add_argument("--migration-head", required=required)
    parser.add_argument("--rollback-target-sha", required=required)
    parser.add_argument("--rollback-target-release", required=required)


def main() -> int:
    args = build_parser().parse_args()
    try:
        if args.command == "generate":
            payload = generate_release_manifest(
                root=args.root,
                output=args.output,
                candidate_sha=args.candidate_sha,
                tooling_sha=args.tooling_sha,
                migration_head=args.migration_head,
                rollback_target_sha=args.rollback_target_sha,
                rollback_target_release=args.rollback_target_release,
                artifacts={
                    role: getattr(args, f"{role}_artifact") for role in ARTIFACT_ROLES
                },
            )
            result = {
                "result": "PASS",
                "contract": payload["contract"],
                "manifest_sha256": payload["manifest_sha256"],
                "output": str(args.output),
            }
        else:
            verified = verify_release_manifest(
                args.manifest,
                root=args.root,
                candidate_sha=args.candidate_sha,
                tooling_sha=args.tooling_sha,
                migration_head=args.migration_head,
                rollback_target_sha=args.rollback_target_sha,
                rollback_target_release=args.rollback_target_release,
            )
            result = {
                "result": "PASS",
                "candidate_sha": verified.candidate_sha,
                "tooling_sha": verified.tooling_sha,
                "migration_head": verified.migration_head,
                "rollback_target_sha": verified.rollback_target_sha,
                "rollback_target_release": verified.rollback_target_release,
                "manifest_sha256": verified.manifest_sha256,
                "artifacts_verified": len(verified.artifacts),
            }
    except (OSError, ReleaseManifestError) as error:
        print(f"BLOCKED: {safe_error(error)}", file=sys.stderr)
        return 2
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
