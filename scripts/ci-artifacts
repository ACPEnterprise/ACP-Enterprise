#!/usr/bin/env python3
"""Build or independently verify immutable CI application/tooling artifacts."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPOSITORY_ROOT / "backend"))

from development_factory.ci_artifacts import (
    CIArtifactError,
    build_ci_artifacts,
    safe_error,
    verify_ci_artifacts,
)


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    commands = root.add_subparsers(dest="command", required=True)
    build = commands.add_parser("build")
    build.add_argument("--repository", type=Path, default=REPOSITORY_ROOT)
    build.add_argument("--output-directory", type=Path, required=True)
    build.add_argument("--candidate-sha", required=True)
    verify = commands.add_parser("verify")
    verify.add_argument("--repository", type=Path, default=REPOSITORY_ROOT)
    verify.add_argument("--manifest", type=Path, required=True)
    verify.add_argument("--candidate-sha", required=True)
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "build":
            result = build_ci_artifacts(
                repository=args.repository,
                output_directory=args.output_directory,
                candidate_sha=args.candidate_sha,
            )
            output = {
                "candidate_sha": result["candidate_sha"],
                "manifest_sha256": result["manifest_sha256"],
                "result": "PASS",
            }
        else:
            output = {
                **verify_ci_artifacts(
                    repository=args.repository,
                    manifest_path=args.manifest,
                    candidate_sha=args.candidate_sha,
                ),
                "result": "PASS",
            }
    except (CIArtifactError, OSError) as error:
        print(f"BLOCKED: {safe_error(error)}", file=sys.stderr)
        return 2
    print(json.dumps(output, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
