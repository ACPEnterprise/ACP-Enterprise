#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
compose_file="$repository_root/docker-compose.redis-qualification.yml"
project_name="acp-redis-qualification-$$"
qualification_root=$(mktemp -d "${TMPDIR:-/tmp}/acp-redis-qualification.XXXXXX")
secret_dir="$qualification_root/secrets"

cleanup() {
  REDIS_QUALIFICATION_SECRET_DIR="$secret_dir" \
    docker compose -p "$project_name" -f "$compose_file" \
    down --volumes --remove-orphans >/dev/null 2>&1 || true
  rm -rf "$qualification_root"
}
trap cleanup EXIT HUP INT TERM

umask 077
mkdir -m 700 "$secret_dir"
printf '%s\n' "redis-application-qualification-$project_name" > "$secret_dir/application-password"
printf '%s\n' "redis-health-qualification-$project_name" > "$secret_dir/health-password"
printf '%s\n' "redis-breakglass-qualification-$project_name" > "$secret_dir/breakglass-password"
"$repository_root/scripts/render-redis-acl" \
  "$secret_dir/application-password" \
  "$secret_dir/health-password" \
  "$secret_dir/breakglass-password" \
  "$secret_dir/users.acl"

export REDIS_QUALIFICATION_SECRET_DIR="$secret_dir"
docker compose -p "$project_name" -f "$compose_file" config --quiet
docker compose -p "$project_name" -f "$compose_file" up \
  --build \
  --abort-on-container-exit \
  --exit-code-from qualification
