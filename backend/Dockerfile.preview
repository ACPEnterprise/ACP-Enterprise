FROM python@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --no-install-recommends --yes git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /opt/venv \
    && addgroup --system acp \
    && adduser --system --ingroup acp --home /app acp

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    && pip uninstall --yes pip \
    && /usr/local/bin/python -m pip uninstall --yes pip

COPY --chown=acp:acp backend/ .
# Release qualification invokes these checks from inside the assembled backend
# image. Keep the exact reviewed implementations in the image rather than
# relying on a host-only checkout or an unverified bind mount.
COPY --chown=acp:acp scripts/protected-database-security-probe.py /app/scripts/protected-database-security-probe.py
COPY --chown=acp:acp scripts/protected-runtime-check.py /app/scripts/protected-runtime-check.py
COPY --chown=acp:acp scripts/protected-smoke-check.py /app/scripts/protected-smoke-check.py

USER acp

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers", "--no-access-log"]
