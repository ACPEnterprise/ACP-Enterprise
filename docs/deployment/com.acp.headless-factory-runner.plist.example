<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.acp.headless-factory-runner</string>
  <key>ProgramArguments</key><array>
    <string>REPLACE_PYTHON</string><string>-m</string><string>scripts.headless_factory_runner</string>
    <string>--company-id</string><string>REPLACE_COMPANY_ID</string>
    <string>--worker-session-id</string><string>REPLACE_CURRENT_WORKER_SESSION_ID</string>
    <string>--authority-sha</string><string>REPLACE_EXACT_PROTECTED_AUTHORITY</string>
    <string>--delegation-id</string><string>REPLACE_ACTIVE_DELEGATION_ID</string>
    <string>--delegation-expires-at</string><string>REPLACE_DELEGATION_EXPIRATION</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_BACKEND_DIRECTORY</string>
  <key>EnvironmentVariables</key><dict>
    <key>PYTHONPATH</key><string>REPLACE_BACKEND_DIRECTORY</string>
    <key>ACP_HEADLESS_REFRESH_TOKEN_FILE</key><string>REPLACE_MODE_0600_REFRESH_TOKEN_FILE</string>
    <key>ACP_CONTROL_API_URL</key><string>https://preview.allcountyhomeservices.com</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>REPLACE_LOG_DIRECTORY/headless-runner.out.log</string>
  <key>StandardErrorPath</key><string>REPLACE_LOG_DIRECTORY/headless-runner.err.log</string>
</dict></plist>
