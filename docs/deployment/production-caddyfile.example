# Install only after the Production runtime has a stable public address and the
# app.twelve-hats.com DNS record has been separately approved.
app.twelve-hats.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy 127.0.0.1:{$ACP_PRODUCTION_HTTP_PORT}
}
