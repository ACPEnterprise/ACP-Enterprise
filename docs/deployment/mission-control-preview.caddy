preview.allcountyhomeservices.com {
	handle /mission-control* {
		reverse_proxy 127.0.0.1:18008
	}

	handle /engineering* {
		reverse_proxy 127.0.0.1:18008
	}

	handle /mission-assets/* {
		uri strip_prefix /mission-assets
		reverse_proxy 127.0.0.1:18008
	}

	handle /api/v1/engineering/mobile* {
		reverse_proxy 127.0.0.1:18008
	}

	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
