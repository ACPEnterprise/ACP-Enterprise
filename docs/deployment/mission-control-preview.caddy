preview.allcountyhomeservices.com {
	@qbo_oauth_callback path /api/v1/integrations/qbo/oauth/callback
	log_skip @qbo_oauth_callback

	handle /mission-control* {
		reverse_proxy 127.0.0.1:18008
	}

	handle /engineering* {
		reverse_proxy 127.0.0.1:18008
	}

	handle /mission-assets/* {
		uri strip_prefix /mission-assets
		reverse_proxy 127.0.0.1:18008
	}

	handle /api/v1/engineering/mobile* {
		reverse_proxy 127.0.0.1:18008
	}

	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

# The isolated API container must retain the Compose-owned security boundary:
#
#   ENVIRONMENT=preview
#   TRUST_FORWARDED_HEADERS=true
#   TRUSTED_PROXY_CIDRS=["172.32.0.0/24"]
#
# Do not recreate it from the shared env file alone: ENVIRONMENT and the
# isolated Docker network CIDR are service configuration, not secrets. Run
# scripts/verify-mission-control-preview.sh after every API or Caddy replacement.
