{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twelve-hats.com/schemas/lia-voice-rights-lineage.v1.json",
  "title": "LIA Voice Rights Lineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "session_id", "source_person_or_source_class", "acquisition_date", "capture_location_class", "recording_owner", "rights_document_reference", "synthetic_voice_training_right", "model_training_right", "derivative_model_right", "commercial_use_right", "perpetual_use_right", "exclusivity_status", "revocation_constraints", "territorial_scope", "data_retention_rule", "deletion_rule", "approval_status", "approver", "checksum", "source_file_digest", "transcript_digest", "quality_status", "admission_status"],
  "properties": {
    "asset_id": {"type": "string", "pattern": "^LIA-AUDIO-[A-Z0-9-]+$"},
    "session_id": {"type": "string", "pattern": "^LIA-SESSION-[A-Z0-9-]+$"},
    "source_person_or_source_class": {"type": "string"},
    "acquisition_date": {"type": "string", "format": "date"},
    "capture_location_class": {"type": "string"},
    "recording_owner": {"const": "TWELVE_HATS"},
    "rights_document_reference": {"type": "string"},
    "synthetic_voice_training_right": {"type": "boolean"},
    "model_training_right": {"type": "boolean"},
    "derivative_model_right": {"type": "boolean"},
    "commercial_use_right": {"type": "boolean"},
    "perpetual_use_right": {"type": "boolean"},
    "exclusivity_status": {"type": "string"},
    "revocation_constraints": {"type": "string"},
    "territorial_scope": {"type": "string"},
    "data_retention_rule": {"type": "string"},
    "deletion_rule": {"type": "string"},
    "approval_status": {"enum": ["PENDING", "APPROVED", "REJECTED", "REVOKED"]},
    "approver": {"type": "string"},
    "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source_file_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "transcript_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "quality_status": {"enum": ["PENDING", "PASSED", "FAILED", "CALIBRATION_PENDING"]},
    "quarantine_reason": {"type": ["string", "null"]},
    "dataset_version": {"type": ["string", "null"]},
    "admission_status": {"enum": ["PROPOSED", "RIGHTS_PENDING", "QUALITY_PENDING", "ADMITTED", "QUARANTINED", "REJECTED", "REVOKED"]}
  }
}
