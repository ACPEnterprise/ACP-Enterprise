{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enterprise-release-authority-trust/v1",
  "title": "TwelveHats Beta Enterprise release authority trust registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "authority",
    "independent_review",
    "keys",
    "issuer_utility_sha256",
    "enrolled_at",
    "registry_digest"
  ],
  "properties": {
    "contract": {"const": "enterprise-release-authority-trust/v1"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "scope", "custodian"],
      "properties": {
        "id": {"const": "twelvehats-beta-release-authority"},
        "role": {"const": "Enterprise Release Authority"},
        "scope": {"const": "BETA_PREVIEW"},
        "custodian": {"$ref": "#/$defs/person"}
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reviewer",
        "issuer_may_not_review",
        "maximum_age_hours"
      ],
      "properties": {
        "required": {"const": true},
        "reviewer": {
          "allOf": [
            {"$ref": "#/$defs/person"},
            {
              "type": "object",
              "required": ["role"],
              "properties": {
                "role": {"const": "Enterprise Independent Qualification Reviewer"}
              }
            }
          ]
        },
        "issuer_may_not_review": {"const": true},
        "maximum_age_hours": {"const": 72}
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/key"}
    },
    "issuer_utility_sha256": {"$ref": "#/$defs/sha256"},
    "enrolled_at": {"type": "string", "format": "date-time"},
    "registry_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"type": "string"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key": {
      "type": "object",
      "required": [
        "key_id",
        "algorithm",
        "public_key_file",
        "private_key_file",
        "public_key_sha256",
        "valid_from",
        "expires_at",
        "status",
        "enrollment_digest",
        "owner_approval_id"
      ],
      "properties": {
        "key_id": {"type": "string", "pattern": "^beta-era-[0-9]{8}-[0-9a-f]{12}$"},
        "algorithm": {"const": "Ed25519"},
        "public_key_file": {"type": "string", "pattern": "^public/beta-era-[0-9]{8}-[0-9a-f]{12}\\.public\\.pem$"},
        "private_key_file": {"type": "string", "pattern": "^private/beta-era-[0-9]{8}-[0-9a-f]{12}\\.private\\.pem$"},
        "public_key_sha256": {"$ref": "#/$defs/sha256"},
        "valid_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["active", "verification_only", "revoked"]},
        "enrollment_digest": {"$ref": "#/$defs/sha256"},
        "owner_approval_id": {"type": "string", "format": "uuid"},
        "verify_until": {"type": "string", "format": "date-time"},
        "revoked_at": {"type": "string", "format": "date-time"},
        "revocation_reason": {"type": "string", "minLength": 1},
        "revocation_approval_id": {"type": "string", "format": "uuid"}
      },
      "additionalProperties": false
    }
  }
}
