{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp.example/schemas/milestone-bank-v2.schema.json",
  "title": "ACP Enterprise Milestone Bank v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bank_id",
    "purpose",
    "authoritative_start_sha",
    "generated_on",
    "activation_semantics",
    "canonical_runtime_manifest",
    "integration_rule",
    "active_ownership",
    "milestones",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "bank_id": {"const": "BANK.2"},
    "purpose": {"type": "string", "minLength": 1},
    "authoritative_start_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_on": {"type": "string", "format": "date"},
    "activation_semantics": {"const": "NONE_PLANNING_ONLY"},
    "canonical_runtime_manifest": {"type": "string", "minLength": 1},
    "integration_rule": {"type": "string", "minLength": 1},
    "active_ownership": {"type": "object", "minProperties": 1},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "milestones": {
      "type": "array",
      "minItems": 200,
      "maxItems": 300,
      "items": {"$ref": "#/$defs/milestone"}
    }
  },
  "$defs": {
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone_id",
        "name",
        "domain",
        "objective",
        "priority",
        "readiness_state",
        "ownership_state",
        "dependencies",
        "repository_evidence",
        "dependency_type",
        "readiness_conditions",
        "implementation_boundary",
        "excluded_scope",
        "likely_repository_areas",
        "collision_domain",
        "owner_decision_required",
        "finance_decision_required",
        "external_gate",
        "schema_migration_risk",
        "production_risk",
        "validation_contract",
        "completion_evidence",
        "successor_ids"
      ],
      "properties": {
        "milestone_id": {"type": "string", "pattern": "^BANK\\.[A-Z0-9]+\\.[0-9]{3}$"},
        "name": {"type": "string", "minLength": 3},
        "domain": {"type": "string", "minLength": 2},
        "objective": {"type": "string", "minLength": 20},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "readiness_state": {"enum": ["READY", "BLOCKED_DEPENDENCY", "BLOCKED_OWNER_DECISION", "BLOCKED_FINANCE_DECISION", "BLOCKED_EXTERNAL", "DEFERRED"]},
        "ownership_state": {"enum": ["UNOWNED", "ACTIVE_OWNED", "RESERVED_FUTURE"]},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^BANK\\.[A-Z0-9]+\\.[0-9]{3}$"}},
        "repository_evidence": {"$ref": "#/$defs/nonemptyStrings"},
        "dependency_type": {"enum": ["HARD_ALL"]},
        "readiness_conditions": {"$ref": "#/$defs/nonemptyStrings"},
        "implementation_boundary": {"type": "string", "minLength": 20},
        "excluded_scope": {"$ref": "#/$defs/nonemptyStrings"},
        "likely_repository_areas": {"$ref": "#/$defs/nonemptyStrings"},
        "collision_domain": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "owner_decision_required": {"type": "boolean"},
        "finance_decision_required": {"type": "boolean"},
        "external_gate": {"type": "string", "minLength": 1},
        "schema_migration_risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "production_risk": {"const": "PROHIBITED_UNTIL_SEPARATE_AUTHORIZATION"},
        "validation_contract": {"$ref": "#/$defs/nonemptyStrings"},
        "completion_evidence": {"$ref": "#/$defs/nonemptyStrings"},
        "successor_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^BANK\\.[A-Z0-9]+\\.[0-9]{3}$"}}
      }
    }
  }
}
